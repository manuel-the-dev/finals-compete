# FINALS COMPETE – example configuration with placeholders only.
# Real values belong in the hosting provider (Vercel, GitHub environments). NEVER commit them.

# development | test | preview | production
APP_ENV=development
# Postgres connection string (Neon: use the pooled connection string for the web app)
DATABASE_URL=postgres://user:password@host:5432/finals_compete
# Random string, min. 32 chars (e.g. `openssl rand -base64 48`). Rotating it logs everyone out.
SESSION_SECRET=replace-with-random-string-of-at-least-32-characters
# Protects /api/cron/sync if an HTTP cron is used instead of GitHub Actions.
CRON_SECRET=replace-with-random-string
# Public URL, e.g. https://finals-compete.example
PUBLIC_BASE_URL=
# Virtual coins granted at registration (no monetary value)
STARTING_BALANCE=1000

# Sent with every request to data sources. Must contain contact details (Liquipedia requirement).
SOURCE_USER_AGENT="FINALS-COMPETE/1.0 (https://your-domain.example; contact@your-domain.example)"

# Liquipedia LPDB API v3 – request a key via https://liquipedia.net/api-terms-of-use
LIQUIPEDIA_API_KEY=
LIQUIPEDIA_WIKI=thefinals

# FACEIT Data API – server-side key from https://developers.faceit.com
FACEIT_API_KEY=
# Comma-separated championship ids, optional ":official" (default) or ":unverified"
FACEIT_CHAMPIONSHIP_IDS=

# YouTube channel feeds: "channelId:kind:Label,..."  kind = official|organizer|team|player|community
YOUTUBE_CHANNELS=

# Twitch Helix (app access token via client credentials)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# "login:kind:Label,..."
TWITCH_CHANNELS=

# X API v2 (pay-per-use, billed per post read). "numericUserId:kind:handle,..."
X_BEARER_TOKEN=
X_ACCOUNTS=
X_MAX_POSTS_PER_RUN=20

# Discord bot in YOUR OWN server that follows official announcement channels. "guildId/channelId:kind:Label,..."
DISCORD_BOT_TOKEN=
DISCORD_CHANNELS=
